<%- include('partials/_head', { pageTitle: 'KELLY LIN — ' + outfit.titleEn + ' / ' + outfit.titleZh }) %>

<section class="head-strip">
  <div class="num"><%= outfit.numLabel %></div>
  <div class="title-block">
    <div class="eyebrow">KELLY LIN · 2026 S/S</div>
    <h1><%= outfit.titleEn %></h1>
    <div class="zh"><%= outfit.titleZh %></div>
  </div>
  <div class="side">Outfit № <%= outfit.numLabel %></div>
</section>

<section class="main">
  <% const totalCells = (outfit.video ? 1 : 0) + outfit.photos.length; %>
  <div class="gallery <%= totalCells === 1 ? 'single' : '' %>">
    <% if (outfit.video) { %>
      <div class="cell video-cell">
        <video src="/photos/<%= outfit.video %>" controls playsinline preload="metadata"></video>
        <div class="cap"><%= outfit.titleEn %> · Video</div>
      </div>
    <% } %>
    <% outfit.photos.forEach((p, i) => { %>
      <div class="cell" onclick="openLightbox(<%= i %>)">
        <img src="/photos/<%= p %>" alt="<%= outfit.titleEn %> · <%= i+1 %>" loading="lazy" />
        <div class="cap"><%= outfit.titleEn %> · <%= i+1 %></div>
      </div>
    <% }) %>
  </div>

  <aside class="desc-panel">
    <%
      const lineOfficialId = '@743hawgb';
      const lineOrderMessage = [
        '您好，我要直接訂購：',
        `款式：${outfit.titleEn || outfit.style || outfit.titleZh || '未填寫'}`,
        `編號：${outfit.itemNo || '未填寫'}`,
        `尺寸：${outfit.size || '未填寫'}`,
        `價格：${outfit.price || '未填寫'}`
      ].join('\n');
      const lineOrderUrl = `https://line.me/R/oaMessage/${encodeURIComponent(lineOfficialId)}/?${encodeURIComponent(lineOrderMessage)}`;
    %>
    <div class="eyebrow">Item details</div>
    <h2><%= outfit.titleEn %></h2>
    <div class="divider"></div>

    <div class="label">款式名稱 / Style</div>
    <div class="value"><%= outfit.style || outfit.titleZh %></div>

    <% if (outfit.itemNo) { %>
      <div class="label">編號 / Item No.</div>
      <div class="value"><%= outfit.itemNo %></div>
    <% } %>

    <div class="label">尺寸 / Size</div>
    <div class="value"><%= outfit.size %></div>

    <div class="label">材質 / Fabric</div>
    <div class="value"><%= outfit.fabric %></div>

    <div class="label">價格 / Price</div>
    <div class="value"><%= outfit.price %></div>

    <div class="label">款式說明 / Description</div>
    <div class="value long"><%= outfit.description %></div>

    <a href="<%= lineOrderUrl %>" target="_blank" rel="noopener" class="contact-btn order-btn"
       onclick="if(window.fbq){fbq('track','Contact',{content_name:'<%= outfit.titleEn %>',content_ids:['<%= outfit.id %>']});}">直接訂購</a>
  </aside>
</section>

<!-- Meta Pixel: ViewContent — fires when this outfit page is opened -->
<script>
  if (window.fbq) {
    fbq('track', 'ViewContent', {
      content_type: 'product',
      content_ids: ['<%= outfit.id %>'],
      content_name: '<%= outfit.titleEn %>',
      content_category: '<%= outfit.style || outfit.titleZh %>'
    });
  }
</script>

<div class="back-bar">
  <a href="/">← 回到全部作品</a>
  <a href="/outfit/<%= prev.id %>">← Outfit № <%= prev.numLabel %></a>
  <a href="/outfit/<%= next.id %>">Outfit № <%= next.numLabel %> →</a>
</div>

<div class="lightbox" id="lightbox">
  <button class="close" onclick="closeLightbox()">×</button>
  <button class="nav-btn prev" onclick="navLightbox(-1)">‹</button>
  <img id="lightbox-img" src="" alt="" />
  <button class="nav-btn next" onclick="navLightbox(1)">›</button>
  <div class="counter" id="lightbox-counter"></div>
</div>

<script>
  const IMAGES = <%- JSON.stringify(outfit.photos.map(p => '/photos/' + p)) %>;
  let currentIdx = 0;
  function openLightbox(idx) {
    currentIdx = idx;
    const lb = document.getElementById('lightbox');
    document.getElementById('lightbox-img').src = IMAGES[idx];
    document.getElementById('lightbox-counter').textContent = (idx+1) + ' / ' + IMAGES.length;
    lb.classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closeLightbox() {
    document.getElementById('lightbox').classList.remove('open');
    document.body.style.overflow = '';
  }
  function navLightbox(delta) {
    currentIdx = (currentIdx + delta + IMAGES.length) % IMAGES.length;
    document.getElementById('lightbox-img').src = IMAGES[currentIdx];
    document.getElementById('lightbox-counter').textContent = (currentIdx+1) + ' / ' + IMAGES.length;
  }
  document.getElementById('lightbox').addEventListener('click', (e) => {
    if (e.target.id === 'lightbox') closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    const lb = document.getElementById('lightbox');
    if (!lb.classList.contains('open')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft')  navLightbox(-1);
    if (e.key === 'ArrowRight') navLightbox(1);
  });
</script>

<%- include('partials/_footer') %>
